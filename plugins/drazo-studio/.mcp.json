{
  "mcpServers": {
    "drazo-studio": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/mcp-drazo-studio.mjs"],
      "env": {
        "DRAZO_LICENCIA": "${user_config.licencia}",
        "DRAZO_SERVIDOR": "${user_config.servidor}"
      },
      "timeout": 900000
    }
  }
}
